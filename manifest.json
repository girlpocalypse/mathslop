{
  "manifest_version": 3,
  "name": "mathslop",
  "version": "1.0.0",
  "description": "A multiline math scratchpad in the side panel, with live answers.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Open mathslop",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "sandbox": { "pages": ["sandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self'; connect-src 'none'; img-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; base-uri 'none'; form-action 'none'"
  }
}
